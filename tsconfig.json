{
  // Browser build: compiles the game to dist/ for index.html.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["main.ts", "engine/**/*.ts", "bot/**/*.ts", "coach/**/*.ts", "lessons/**/*.ts", "puzzles/**/*.ts", "net/**/*.ts", "ui/**/*.ts"]
}

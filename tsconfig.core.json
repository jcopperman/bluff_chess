{
  // Engine, bot, coach and lessons: no DOM and no Node types, so the compiler enforces that the
  // game logic never touches browser or platform APIs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "lib": ["ES2022"], "noEmit": true },
  "include": ["engine/**/*.ts", "bot/**/*.ts", "coach/**/*.ts", "lessons/**/*.ts"]
}

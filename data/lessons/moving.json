{
  "id": "moving",
  "title": "Moving & capturing",
  "audience": "chess",
  "blurb": "How every chess piece moves and captures. Skip this if you already play chess.",
  "steps": [
    {
      "say": "Welcome! Let's start with plain chess. The <b>rook</b> moves any distance in a straight line: up, down, left or right. Capture the pawn on <b>d7</b> with your rook.",
      "position": {
        "pieces": [
          {
            "id": "w-k",
            "owner": "white",
            "type": "king",
            "square": "a1"
          },
          {
            "id": "b-k",
            "owner": "black",
            "type": "king",
            "square": "h8"
          },
          {
            "id": "w-r",
            "owner": "white",
            "type": "rook",
            "square": "d4",
            "faceUp": true
          },
          {
            "id": "b-p",
            "owner": "black",
            "type": "pawn",
            "square": "d7"
          }
        ]
      },
      "expect": [
        {
          "from": "d4",
          "to": "d7"
        }
      ],
      "highlight": [
        "d4",
        "d7"
      ],
      "hint": "Select your rook on d4, then d7.",
      "success": "Captured! Pieces capture by moving onto an enemy's square."
    },
    {
